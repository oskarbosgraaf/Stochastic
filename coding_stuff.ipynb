   "source": [
    "import numpy as np\n",
    "import csv\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "80c40157",
   "metadata": {},
   "outputs": [],
   "source": [
    "import csv\n+    "\n",
    "with open(\"airport.csv\", newline=\"\", encoding=\"utf-8\") as csvfile:\n",
    "    rows = list(csv.DictReader(csvfile))\n",
    "\n",
    "september_rows = [\n",
    "    row for row in rows\n",
    "    if row[\"Month\"] == \"September\" and int(row[\"Year\"]) <= 2019\n",
    "]\n",
    "\n",
    "numeric_columns = [\n",
    "    column for column in rows[0]\n",
    "    if column not in (\"Year\", \"Month\")\n",
    "]\n",
    "\n",
    "september_average = {\n",
    "    column: np.mean([int(row[column]) for row in september_rows])\n",
    "    for column in numeric_columns\n",
    "}\n",
    "\n",
    "print(f\"September rows: {len(september_rows)}\")\n",
    "for column, average in september_average.items():\n",
    "    print(f\"{column}: {average:.2f}\")"
   ]
  },
